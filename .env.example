# Anthropic API key (required for AI responses)
ANTHROPIC_API_KEY=sk-ant-...

# Model to use (optional, defaults to claude-sonnet-5)
# ANTHROPIC_MODEL=claude-sonnet-5

# Database encryption key (optional if ~/.aslam/.key exists)
# ASLAM_KEY=your-encryption-key

# Database path (optional, defaults to ~/.aslam/aslam.db)
# ASLAM_DB=/path/to/aslam.db

# Force email/password registration on or off. Unset, it follows whether
# outbound email is configured: signups are verified by emailing a one-time
# link, and without SMTP there is no way to prove an address. Signup stays
# open regardless when GOOGLE_CLIENT_ID is unset, so a fresh install cannot
# lock itself out.
# ALLOW_PASSWORD_SIGNUP=true

# Public origin used to build links in outbound email (verification links).
# Falls back to the host from GOOGLE_REDIRECT_URI, then https://aslam.org
# BASE_URL=https://aslam.org

# Email assistant (optional) - the inbox the assistant reads and replies from
# GMAIL_USER=assistant@aslam.org
# GMAIL_APP_PASSWORD=your-app-password

# authserv-id your receiving server stamps into Authentication-Results.
# Only a header bearing this id is trusted to authenticate a sender.
# EMAIL_AUTHSERV_ID=mx.google.com

# Accept mail whose sending domain could not be authenticated. Only for
# receiving servers that add no Authentication-Results header: it lets a
# forged From header walk straight past the allowlist.
# EMAIL_ALLOW_UNVERIFIED=false

# Server port (optional, defaults to 8000)
# PORT=8000
