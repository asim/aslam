# Include in nginx's http {} context (e.g. sites-enabled on Debian).
# Merge with existing virtual hosts; each address/port can have only one default.
# Requires nginx >= 1.19.4 for ssl_reject_handshake. Keep your actual certificate
# paths and any existing ACME challenge locations before enabling this example.
limit_req_zone $binary_remote_addr zone=aslam_per_ip:1m rate=5r/s;
limit_conn_zone $binary_remote_addr zone=aslam_connections:1m;

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 444;
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
    return 444;
}

server {
    listen 80;
    listen [::]:80;
    server_name aslam.org www.aslam.org;
    if ($host !~* ^(www\.)?aslam\.org$) { return 444; }
    return 301 https://aslam.org$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name aslam.org www.aslam.org;
    ssl_certificate /etc/letsencrypt/live/aslam.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/aslam.org/privkey.pem;

    # Also reject a foreign HTTP Host after a TLS handshake with valid SNI.
    if ($host !~* ^(www\.)?aslam\.org$) { return 444; }

    client_header_timeout 5s;
    client_body_timeout 15s;
    client_max_body_size 1m;
    keepalive_timeout 30s;
    send_timeout 15s;
    limit_req zone=aslam_per_ip burst=20 nodelay;
    limit_req_status 429;
    limit_conn aslam_connections 10;
    limit_conn_status 429;

    # Numeric loopback avoids localhost resolving to two upstream addresses.
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Connection "";
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 2s;
    proxy_send_timeout 15s;
    proxy_read_timeout 20s;
    proxy_next_upstream off;

    location / {
        proxy_pass http://127.0.0.1:8000;
    }

    # The assistant can take longer than public reader/search requests.
    location = /api/chat/send {
        proxy_pass http://127.0.0.1:8000;
        proxy_read_timeout 310s;
        proxy_buffering off;
    }
    location = /chat/send {
        proxy_pass http://127.0.0.1:8000;
        proxy_read_timeout 310s;
    }
}
