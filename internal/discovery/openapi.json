    "/api/chat/send": {
      "post": {
        "summary": "Ask a question in your chat",
        "description": "Owner only, including for admins. Streams plain text. Uses the account daily question allowance; tool follow-ups are included. Admins are quota-exempt. Quota/model errors may arrive after the stream has started.",
        "responses": {
          "200": {
            "description": "Chunked plain text answer with sources footer. Errors after headers are emitted as Error: text.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Missing or invalid account key/session"
          },
          "403": {
            "description": "Access denied"
          },
          "404": {
            "description": "Not found or not accessible"
          },
          "503": {
            "description": "Busy or temporarily unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "conversation_id": {
                    "type": "integer"
                  },
                  "message": {
                    "type": "string",
                    "description": "Up to 8192 UTF-8 bytes"
                  }
                },
                "required": [
                  "conversation_id",
                  "message"
                ]
              }
            }
          }
        }
      }
    },
