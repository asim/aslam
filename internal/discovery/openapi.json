          "quran",
          "hadith",
          "names",
          "seerah",
          "tafsir",
          "ghazali",
          "islamqa",
          "adhkar",
          "salihin",
          "arabic",
          "roots",
          "reading",
          "stories"
        ]
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "SearchResponse": {
        "type": "object",
        "required": [
          "results"
        ],
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SearchResult"
            }
          }
        }
      },
      "SearchResult": {
        "type": "object",
        "required": [
          "Kind",
          "Source"
        ],
        "properties": {
          "Kind": {
            "$ref": "#/components/schemas/Collection"
          },
          "Title": {
            "type": "string"
          },
          "Content": {
            "type": "string",
            "description": "Excerpt, not necessarily the full passage"
          },
          "Role": {
            "type": "string",
            "description": "Source attribution or context"
          },
          "Source": {
            "type": "string",
            "description": "Collection attribution"
          },
          "URL": {
            "type": "string",
            "description": "Relative reader URL path; resolve against https://aslam.org"
          }
        },
        "additionalProperties": true
      },
      "ResourceResponse": {
        "type": "object",
        "required": [
          "kind",
          "source",
          "url",
          "resource"
        ],
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/Collection"
          },
          "source": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Absolute citation URL"
          },
          "resource": {
            "type": "object",
            "additionalProperties": true,
            "description": "Full collection-specific record. Fields and casing vary. Preserve Arabic, translation, commentary and attribution where present; Seerah includes Title, Content, Page, Author and Translator."
          }
        }
      }
    },
