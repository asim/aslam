{
  "openapi": "3.1.0",
  "info": {
    "title": "Aslam API",
    "version": "2.0.0",
    "description": "Knowledge browsing, retrieval and account APIs. Create an account key in Settings \u2192 API keys; send Authorization: Bearer YOUR_KEY. Search stays public. Existing signed-in browser sessions also work on HTTP account endpoints. MCP requires a key. Keys inherit the account permissions and question limits. Administrative and sign-in operations are not integration APIs."
  },
  "servers": [
    {
      "url": "https://aslam.org"
    }
  ],
  "security": [
    {
      "AccountKey": []
    }
  ],
  "externalDocs": {
    "description": "Agent guide",
    "url": "https://aslam.org/llms.txt"
  },
  "paths": {
    "/api/knowledge/search": {
      "get": {
        "operationId": "searchKnowledge",
        "summary": "Search published reference collections",
        "description": "Keyword search, not a generated answer. Missing or whitespace-only q returns an empty results array. Results contain excerpts and reader URL paths. No pagination parameter is supported.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Search keywords; trimmed value must not exceed 1000 UTF-8 bytes.",
            "schema": {
              "type": "string"
            },
            "example": "patience"
          },
          {
            "name": "collection",
            "in": "query",
            "required": false,
            "description": "Omit or leave empty to search all collections.",
            "schema": {
              "type": "string",
              "enum": [
                "",
                "quran",
                "hadith",
                "names",
                "seerah",
          "tafsir",
                "ghazali",
                "islamqa",
                "adhkar",
                "salihin"
              ]
            },
            "example": "quran"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum number of results returned.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            },
            "example": 5
          }
        ],
        "responses": {
          "200": {
            "description": "Matching excerpts; results is an empty array when there are no matches",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "400": {
            "description": "Query too long, unknown collection, or invalid limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Only GET is supported",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Knowledge search unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/knowledge/resource": {
      "get": {
        "operationId": "getKnowledgeResource",
        "summary": "Read a complete reference resource",
        "description": "Read a full source by reader path. Also supports /stories/{slug}, /arabic/{id}, /arabic/roots/{code}, /arabic/reading/{chapter}/{verse}. Roots return up to 50 forms and a next URL (offset parameter). Requires an account key or session.",
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "required": true,
            "description": "Reader path for the requested resource. Obtain slugs from search results.",
            "schema": {
              "type": "string"
            },
            "example": "/quran/2/153"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "Root forms only; increments of 50, maximum 100000.",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Full resource and citation metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResourceResponse"
                }
              }
            }
          },
          "400": {
            "description": "Unknown or unsupported knowledge resource path",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Only GET is supported",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Knowledge resource unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Seerah dataset unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
